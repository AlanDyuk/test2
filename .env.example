# Albion Market Strategist Pro - Configuration
# Copy this file to .env and fill in your values

# Password for Streamlit app (will be hashed on first run)
APP_PASSWORD=

# Albion Online API (East server)
API_HOST=https://east.albion-online-data.com

# Scheduler settings
SCHEDULER_INTERVAL=300

# Streamlit server (for cloud deployment)
STREAMLIT_SERVER_PORT=8501
